{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "KPIs do último ano completo",
      "queryLines": [
        "SELECT ano,\n",
        "       COUNT(*) AS empresas,\n",
        "       AVG(CASE WHEN cria_valor THEN 1.0 ELSE 0.0 END) AS pct_cria_valor,\n",
        "       AVG(CASE WHEN classificacao_risco = 'Crítico' THEN 1.0 ELSE 0.0 END) AS pct_critico,\n",
        "       percentile_approx(roe, 0.5) AS roe_mediano,\n",
        "       MAX(cdi_acumulado) AS cdi_acumulado\n",
        "FROM workspace.gold.indicadores_financeiros\n",
        "WHERE ano = (SELECT MAX(ano) FROM workspace.gold.macro_anual WHERE meses_ipca = 12) AND situacao = 'ATIVO'\n",
        "GROUP BY ano\n"
      ]
    },
    {
      "name": "ds_risco",
      "displayName": "Classificação de risco por ano",
      "queryLines": [
        "SELECT ano, classificacao_risco, COUNT(*) AS empresas\n",
        "FROM workspace.gold.indicadores_financeiros\n",
        "WHERE situacao = 'ATIVO'\n",
        "GROUP BY ano, classificacao_risco\n"
      ]
    },
    {
      "name": "ds_macro",
      "displayName": "Macro mensal",
      "queryLines": [
        "SELECT mes, selic_fim_mes * 100 AS selic_pct_aa, ipca_12m * 100 AS ipca_12m_pct, dolar_medio\n",
        "FROM workspace.gold.macro_mensal\n",
        "WHERE mes >= '2020-01-01'\n"
      ]
    },
    {
      "name": "ds_roe_cdi",
      "displayName": "ROE mediano x CDI",
      "queryLines": [
        "SELECT i.ano,\n",
        "       percentile_approx(i.roe, 0.5) * 100 AS roe_mediano_pct,\n",
        "       MAX(i.cdi_acumulado) * 100 AS cdi_pct,\n",
        "       MAX(i.ipca_acumulado) * 100 AS ipca_pct\n",
        "FROM workspace.gold.indicadores_financeiros i\n",
        "WHERE i.situacao = 'ATIVO'\n",
        "GROUP BY i.ano\n"
      ]
    },
    {
      "name": "ds_ind",
      "displayName": "Indicadores por empresa",
      "queryLines": [
        "SELECT nome_empresa, setor, ano, classificacao_risco, motivo_risco,\n",
        "       receita_liquida / 1e6 AS receita_mi,\n",
        "       lucro_liquido / 1e6 AS lucro_mi,\n",
        "       divida_liquida / 1e6 AS divida_liquida_mi,\n",
        "       roe * 100 AS roe_pct,\n",
        "       spread_roe_cdi * 100 AS spread_roe_cdi_pp,\n",
        "       margem_ebit * 100 AS margem_ebit_pct,\n",
        "       divida_liquida_ebit,\n",
        "       liquidez_corrente,\n",
        "       cobertura_financeira\n",
        "FROM workspace.gold.indicadores_financeiros\n",
        "WHERE situacao = 'ATIVO'\n"
      ]
    },
    {
      "name": "ds_setor",
      "displayName": "Benchmark setorial",
      "queryLines": [
        "SELECT setor, ano, qtd_empresas,\n",
        "       roe_mediano * 100 AS roe_mediano_pct,\n",
        "       margem_ebit_mediana * 100 AS margem_ebit_mediana_pct,\n",
        "       divida_liquida_ebit_mediana,\n",
        "       pct_cria_valor * 100 AS pct_cria_valor,\n",
        "       pct_critico * 100 AS pct_critico,\n",
        "       receita_total / 1e9 AS receita_bi\n",
        "FROM workspace.gold.benchmark_setorial\n",
        "WHERE qtd_empresas >= 3\n"
      ]
    }
  ],
